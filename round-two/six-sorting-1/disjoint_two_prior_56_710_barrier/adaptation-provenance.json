        [
          "def verified_inputs():\n    old_manifest = json.loads((PILOT/'source-manifest.json').read_text())\n    for row in old_manifest['generated_evidence']:\n        if Path(row['path']).name in ('branch02.json', 'checked02.json', 'checked02-O.json',\n                'cuts02.json', 'free-cut-independent-02-03.json', 'free-cut-independent-02-03-O.json'):\n            need(hashlib.sha256((PILOT/row['path']).read_bytes()).hexdigest() == row['sha256'],\n                 'Already verified complete preparation input changed')\n    cuts = json.loads((PILOT/'work/cuts02.json').read_text())\n    normal = json.loads((PILOT/'work/checked02.json').read_text())\n    optimized = json.loads((PILOT/'work/checked02-O.json').read_text())\n    need(normal['finite'] == optimized['finite'] and normal['finite_sha256'] ==\n         'b710f7d4ebfacf5b079d8f54774dd6c020342b831d831666342eb68d16dbd375' and\n         cuts['classification_sha256'] ==\n         'e9f768d5fb2075c8916efe2d5e77de55949398e52012d7d4f1dcdf41a41bf42a' and\n         len(cuts['retained_function_ids']) == 5295 and LAST <= 5295,\n         'Wrong complete branch2 closure/cut inventory')\n    provenance = json.loads((ROOT/'adaptation-provenance.json').read_text())\n    for row in provenance['files']:\n        need(hashlib.sha256((ROOT/row['file']).read_bytes()).hexdigest() == row['adapted_sha256'],\n             'Credited adapter changed: '+row['file'])\n    return cuts\n\n",
          "def verified_inputs():\n    from bindings import prerequisites\n    from inputs import load\n    prerequisites()\n    return load('cuts')\n\n"
        ]
      ]
