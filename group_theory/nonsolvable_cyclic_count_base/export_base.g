# GAP 4.12.1 / PrimGrp 3.4.3. Exact permutation-class evidence.
# Run from this source directory with -A -b -q --quitonbreak.
# catalogue.g is generated by catalogue.py; it is not a completeness proof.
if LoadPackage("primgrp", "3.4.3") <> true then Error("PrimGrp missing"); fi;
if LoadPackage("smallgrp", "1.5.1") <> true then Error("SmallGrp missing"); fi;
Reset(GlobalMersenneTwister,20261005);
Reset(GlobalRandomSource,20261005);
Read("catalogue.g");
baseGroups := AllSmallNonabelianSimpleGroups([1..724052]);;
if Length(baseGroups) <> Length(baseCatalogue) then Error("catalogue size mismatch"); fi;
if SortedList(List(baseGroups,Size)) <> SortedList(List(baseCatalogue,r->r.order)) then
    Error("catalogue order multiset mismatch");
fi;
out := OutputTextFile("evidence.json",false);;
SetPrintFormattingStatus(out,false);
PrintTo(out,"{\"gap_version\":\"",GAPInfo.Version,
    "\",\"primgrp_version\":\"",PackageInfo("primgrp")[1].Version,
    "\",\"gap_catalogue_orders\":",List(baseGroups,Size),",\"counts\":[\n");
first := true;;
sizes := [];; orders := [];;
for row in baseCatalogue do
    if row.need_count then
        # No order collision occurs among the rows needing a count.
        matching := Filtered(baseGroups,g->Size(g)=row.order);
        if Length(matching) <> 1 then Error("ambiguous group row"); fi;
        group := matching[1];
        classes := ConjugacyClasses(group);
        orders := List(classes,c->Order(Representative(c)));
        sizes := List(classes,Size);
        cyclic_count := Sum([1..Length(classes)],i->sizes[i]/Phi(orders[i]));
        if not IsInt(cyclic_count) then Error("nonintegral cyclic count"); fi;
        if Sum(sizes) <> row.order then Error("class sizes do not sum to order"); fi;
        if not first then PrintTo(out,",\n"); fi;
        first := false;
        PrintTo(out,"{\"name\":\"",row.name,"\",\"order\":",row.order,
            ",\"group_name\":\"",Name(group),"\",\"class_orders\":",orders,
            ",\"class_sizes\":",sizes,",\"cyclic_count\":",cyclic_count,"}");
        Print(row.name," order=",row.order," c=",cyclic_count,"\n");
    fi;
od;
PrintTo(out,"\n]}\n");
CloseStream(out);
Print("catalogue rows: ",Length(baseCatalogue),"; exact counts complete\n");
QUIT;
